{
	"name": "camisama/camisama",
	"description": "Tienda de prendas personalizables: tema de bloques y plugin personalizador para WooCommerce.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"post-install-cmd": "@composer install --working-dir=plugins/camisama-customizer --no-interaction",
		"post-update-cmd": "@composer install --working-dir=plugins/camisama-customizer --no-interaction",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"scripts-descriptions": {
		"lint": "Revisa el código PHP con WordPress Coding Standards.",
		"lint:fix": "Corrige automáticamente lo que se pueda del estándar de código.",
		"analyse": "Análisis estático con PHPStan.",
		"test": "Ejecuta las pruebas unitarias.",
		"check": "Lint + análisis + pruebas (lo mismo que la CI)."
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^11.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/wp-cli-bundle": "^2.12",
		"wp-coding-standards/wpcs": "^3.4"
	}
}
