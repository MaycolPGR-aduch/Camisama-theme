{
	"name": "camisama",
	"version": "0.1.0",
	"private": true,
	"description": "Tienda de prendas personalizables: tema de bloques y plugin personalizador para WooCommerce.",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/MaycolPGR-aduch/Camisama-theme.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=plugins/camisama-customizer/client --output-path=plugins/camisama-customizer/build",
		"start": "wp-scripts start --webpack-src-dir=plugins/camisama-customizer/client --output-path=plugins/camisama-customizer/build",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "wp-scripts lint-js plugins/camisama-customizer/client",
		"lint:css": "wp-scripts lint-style \"plugins/*/client/**/*.{css,scss}\" \"themes/**/*.css\"",
		"format": "wp-scripts format plugins/camisama-customizer/client"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/scripts": "^35.0.0"
	}
}
