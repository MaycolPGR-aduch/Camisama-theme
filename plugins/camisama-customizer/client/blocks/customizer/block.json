{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "camisama/customizer",
	"version": "0.1.0",
	"title": "Personalizador de prendas",
	"category": "woocommerce",
	"icon": "art",
	"description": "Editor para personalizar la prenda con estampados del catálogo, texto e imágenes propias.",
	"keywords": [ "camiseta", "personalizar", "estampado" ],
	"textdomain": "camisama-customizer",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"multiple": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
